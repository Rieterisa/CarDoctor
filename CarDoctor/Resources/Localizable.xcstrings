    "legal.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For informational purposes only. Not a substitute for professional service advice. Follow safety procedures."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bilgilendirme amaçlıdır. Profesyonel servis tavsiyesinin yerini tutmaz. Güvenlik prosedürlerine uyun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con fines informativos. No sustituye el consejo de un taller profesional. Siga las medidas de seguridad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con fines informativos. No sustituye el consejo de un taller profesional. Sigue las medidas de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para informação. Não substitui orientação profissional. Siga os procedimentos de segurança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para fins informativos. Não substitui aconselhamento profissional. Siga os procedimentos de segurança."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सूचना हेतु। पेशेवर सेवा सलाह का विकल्प नहीं। सुरक्षा प्रक्रियाओं का पालन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk informasi. Bukan pengganti saran bengkel profesional. Ikuti prosedur keselamatan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأغراض معلوماتية فقط. لا يغني عن استشارة خدمة محترفة. اتبع إجراءات السلامة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для информации. Не заменяет совет профессионального сервиса. Соблюдайте технику безопасности."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zu Informationszwecken. Kein Ersatz für professionellen Werkstattservice. Sicherheitsregeln beachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À titre informatif uniquement. Ne remplace pas un avis professionnel. Respectez les consignes de sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報提供のみです。専門整備の代替ではありません。安全手順に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보 제공 목적입니다. 전문 정비 조언을 대체하지 않습니다. 안전 절차를 따르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供参考。不能替代专业维修建议。请遵守安全规程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考。不能取代專業維修建議。請遵守安全程序。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mang tính thông tin. Không thay thế tư vấn sửa chữa chuyên nghiệp. Tuân thủ quy trình an toàn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อข้อมูลเท่านั้น ไม่ใช่คำแนะนำจากช่างมืออาชีพ โปรดปฏิบัติตามขั้นตอนความปลอดภัย"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a scopo informativo. Non sostituisce il consiglio di un’officina. Seguire le procedure di sicurezza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącznie w celach informacyjnych. Nie zastępuje porady warsztatu. Przestrzegaj procedur bezpieczeństwa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ter informatie. Geen vervanging van professioneel advies. Volg veiligheidsprocedures."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk maklumat sahaja. Bukan pengganti nasihat servis profesional. Patuhi prosedur keselamatan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa impormasyon lamang. Hindi kapalit ng propesyonal na payo. Sundin ang mga safety procedure."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف معلومات کے لیے۔ پیشہ ورانہ سروس مشورے کا متبادل نہیں۔ حفاظتی طریقہ کار پر عمل کریں۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু তথ্যের জন্য। পেশাদার সার্ভিস পরামর্শের বিকল্প নয়। নিরাপত্তা পদ্ধতি মেনে চলুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای اطلاع‌رسانی. جایگزین مشاوره تخصصی نیست. رویه‌های ایمنی را رعایت کنید."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для інформації. Не замінює пораду професійного сервісу. Дотримуйтесь правил безпеки."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar în scop informativ. Nu înlocuiește sfatul unui service profesionist. Respectați procedurile de siguranță."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pro informaci. Nenahrazuje odborný servis. Dodržujte bezpečnostní postupy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast i informationssyfte. Ersätter inte professionell verkstadsrådgivning. Följ säkerhetsrutiner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για ενημέρωση. Δεν υποκαθιστά επαγγελματική συμβουλή. Ακολουθήστε τις διαδικασίες ασφαλείας."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למידע בלבד. אינו מחליף ייעוץ מקצועי. יש לפעול לפי נהלי בטיחות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak tájékoztató jellegű. Nem helyettesíti a szakszerviz tanácsát. Tartsa be a biztonsági előírásokat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun til information. Erstatter ikke professionel værkstedsrådgivning. Følg sikkerhedsprocedurer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tiedoksi. Ei korvaa ammattilaisen neuvoa. Noudata turvallisuusohjeita."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun til informasjon. Erstatter ikke profesjonell verkstedsrådgivning. Følg sikkerhetsprosedyrer."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len na informáciu. Nenahrádza odborný servis. Dodržiavajte bezpečnostné postupy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo u informativne svrhe. Ne zamjenjuje savjet stručnog servisa. Slijedite sigurnosne postupke."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само за информация. Не замества професионален съвет. Спазвайте мерките за безопасност."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
