    "auth.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + fault code → part, repair steps, and 3D guidance from the community."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şasi + arıza kodu → parça, tamir adımları ve topluluktan 3D rehberlik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + código de fallo → pieza, pasos de reparación y guía 3D de la comunidad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + código de falla → pieza, pasos de reparación y guía 3D de la comunidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + código de falha → peça, passos de reparo e orientação 3D da comunidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + código de avaria → peça, passos de reparação e orientação 3D da comunidade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + दोष कोड → पार्ट, मरम्मत चरण और समुदाय से 3D मार्गदर्शन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + kode kesalahan → suku cadang, langkah perbaikan, dan panduan 3D dari komunitas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم الهيكل + رمز العطل ← القطعة وخطوات الإصلاح وإرشاد ثلاثي الأبعاد من المجتمع."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + код ошибки → деталь, шаги ремонта и 3D‑подсказки от сообщества."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FIN + Fehlercode → Teil, Reparaturschritte und 3D‑Hilfe aus der Community."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + code défaut → pièce, étapes de réparation et guide 3D de la communauté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN＋故障コード → 部品、修理手順、コミュニティの3Dガイド。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + 고장 코드 → 부품, 수리 단계, 커뮤니티의 3D 안내."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + 故障码 → 零件、维修步骤以及社区的 3D 指引。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + 故障碼 → 零件、維修步驟以及社群的 3D 指引。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + mã lỗi → phụ tùng, bước sửa chữa và hướng dẫn 3D từ cộng đồng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + รหัสความผิดปกติ → อะไหล่ ขั้นตอนซ่อม และคำแนะนำ 3D จากชุมชน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + codice guasto → pezzo, passaggi di riparazione e guida 3D dalla community."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + kod usterki → część, kroki naprawy i wskazówki 3D od społeczności."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + storingscode → onderdeel, reparatiestappen en 3D-hulp van de community."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + kod kerosakan → bahagian, langkah pembaikan dan panduan 3D dari komuniti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + fault code → parte, hakbang sa pagkumpuni, at 3D gabay mula sa komunidad."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + خرابی کوڈ → پرزہ، مرمت کے مراحل اور کمیونٹی سے 3D رہنمائی۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + ত্রুটি কোড → যন্ত্রাংশ, মেরামত ধাপ এবং কমিউনিটির 3D নির্দেশনা।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + کد خطا ← قطعه، مراحل تعمیر و راهنمای سه‌بعدی از جامعه."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + код несправності → деталь, кроки ремонту та 3D‑підказки від спільноти."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + cod de eroare → piesă, pași de reparație și ghid 3D din comunitate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + chybový kód → díl, kroky opravy a 3D návod od komunity."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + felkod → del, reparationssteg och 3D‑vägledning från communityn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + κωδικός βλάβης → εξάρτημα, βήματα επισκευής και 3D καθοδήγηση από την κοινότητα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר שלדה + קוד תקלה ← חלק, שלבי תיקון והכוונה תלת־ממדית מהקהילה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvázszám + hibakód → alkatrész, javítási lépések és 3D útmutató a közösségtől."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + fejlkode → del, reparationstrin og 3D-vejledning fra fællesskabet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + vikakoodi → osa, korjausvaiheet ja 3D-opastus yhteisöltä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + feilkode → del, reparasjonstrinn og 3D-veiledning fra fellesskapet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + chybový kód → diel, kroky opravy a 3D návod od komunity."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + kod kvara → dio, koraci popravka i 3D vodič zajednice."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + код на грешка → част, стъпки за ремонт и 3D насоки от общността."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + msimbo wa hitilafu → sehemu, hatua za ukarabati na mwongozo wa 3D kutoka jumuiya."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN + codi d’avaria → peça, passos de reparació i guia 3D de la comunitat."
          }
        }
      }
    },
