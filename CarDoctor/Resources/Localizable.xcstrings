            "state": "translated",
            "value": "अपलोड हो गया। मॉडरेशन लंबित (एडमिन तुरंत प्रकाशित करते हैं)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diunggah. Menunggu moderasi (admin langsung memublikasikan)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الرفع. بانتظار المراجعة (ينشر المشرفون فورًا)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружено. Ожидает модерации (админы публикуют сразу)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochgeladen. Warte auf Moderation (Admins veröffentlichen sofort)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé. En attente de modération (les admins publient immédiatement)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード済み。審査待ち（管理者は即公開）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드됨. 검수 대기 중(관리자는 즉시 게시)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已上传。等待审核（管理员可立即发布）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已上傳。等待審核（管理員可立即發佈）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải lên. Đang chờ kiểm duyệt (quản trị viên đăng ngay)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดแล้ว รอการตรวจสอบ (แอดมินเผยแพร่ได้ทันที)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricato. In attesa di moderazione (gli admin pubblicano subito)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłano. Oczekuje na moderację (admini publikują od razu)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geüpload. Wacht op moderatie (admins publiceren direct)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimuat naik. Menunggu penyederhanaan (admin terbitkan serta-merta)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-upload. Nakabinbin ang moderation (agad magpo-publish ang admin)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپ لوڈ ہو گیا۔ ماڈریشن زیر التوا (ایڈمنز فوری شائع کرتے ہیں)۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপলোড হয়েছে। মডারেশন অপেক্ষমাণ (অ্যাডমিন সাথে সাথে প্রকাশ করে)।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آپلود شد. در انتظار بررسی (مدیران فوری منتشر می‌کنند)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажено. Очікує модерації (адміни публікують одразу)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcat. Așteaptă moderare (adminii publică imediat)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahráno. Čeká na moderaci (admini publikují ihned)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdat. Väntar på moderering (admins publicerar direkt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφορτώθηκε. Εκκρεμεί έλεγχος (οι διαχειριστές δημοσιεύουν αμέσως)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועלה. ממתין לאישור (מנהלים מפרסמים מיד)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltöltve. Moderálásra vár (az adminok azonnal közzéteszik)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploadet. Afventer moderation (admins udgiver med det samme)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladattu. Odottaa moderointia (ylläpitäjät julkaisevat heti)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lastet opp. Venter på moderering (admin publiserer med en gang)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrané. Čaká na moderáciu (admini publikujú ihneď)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitano. Čeka moderaciju (admini objavljuju odmah)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Качено. Чака модерация (админите публикуват веднага)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imepakuliwa. Inasubiri ukaguzi (wasimamizi huchapisha mara moja)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pujat. Pendent de moderació (els admins publiquen a l’instant)."
          }
        }
      }
