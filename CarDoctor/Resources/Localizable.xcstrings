    "diagnose.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a specific VIN and fault code — diagnosis is resolved per vehicle brand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesifik VIN ve arıza kodunu gir — teşhis araç markasına göre çözülür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un VIN y un código de fallo concretos; el diagnóstico se resuelve por marca."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa un VIN y un código de falla específicos; el diagnóstico se resuelve por marca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um VIN e um código de falha específicos — o diagnóstico é por marca do veículo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um VIN e um código de avaria específicos — o diagnóstico é por marca."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशिष्ट VIN और दोष कोड दर्ज करें — निदान वाहन ब्रांड के अनुसार होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan VIN dan kode kesalahan spesifik — diagnosis diselesaikan per merek kendaraan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رقم هيكل ورمز عطل محددين — يتم التشخيص حسب ماركة المركبة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите конкретный VIN и код ошибки — диагностика зависит от марки автомобиля."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine konkrete FIN und einen Fehlercode ein — die Diagnose erfolgt markenspezifisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un VIN et un code défaut précis — le diagnostic est résolu par marque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "具体的なVINと故障コードを入力 — 診断は車種メーカーごとに解決されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구체적인 VIN과 고장 코드를 입력하세요 — 진단은 차량 브랜드별로 처리됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入具体的 VIN 和故障码 — 诊断按车辆品牌解析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入具體的 VIN 和故障碼 — 診斷依車輛品牌解析。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập VIN và mã lỗi cụ thể — chẩn đoán được giải quyết theo từng hãng xe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ VIN และรหัสความผิดปกติที่เฉพาะเจาะจง — การวินิจฉัยแยกตามยี่ห้อรถ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un VIN e un codice guasto specifici — la diagnosi è per marca del veicolo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz konkretny VIN i kod usterki — diagnoza jest rozwiązywana według marki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een specifiek VIN en een storingscode in — diagnose per voertuigmerk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan VIN dan kod kerosakan khusus — diagnosis diselesaikan mengikut jenama kenderaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang partikular na VIN at fault code — ang diagnosis ay ayon sa brand ng sasakyan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مخصوص VIN اور خرابی کوڈ درج کریں — تشخیص گاڑی کے برانڈ کے مطابق ہوتی ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দিষ্ট VIN ও ত্রুটি কোড লিখুন — নির্ণয় যানবাহনের ব্র্যান্ড অনুযায়ী হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VIN و کد خطای مشخص وارد کنید — تشخیص بر اساس برند خودرو انجام می‌شود."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть конкретний VIN і код несправності — діагностика залежить від марки авто."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu un VIN și un cod de eroare specifice — diagnosticul se rezolvă pe marcă."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte konkrétní VIN a chybový kód — diagnostika se řeší podle značky vozidla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett specifikt VIN och en felkod — diagnosen löses per fordonsmärke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε συγκεκριμένο VIN και κωδικό βλάβης — η διάγνωση γίνεται ανά μάρκα οχήματος."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן מספר שלדה וקוד תקלה ספציפיים — האבחון נפתר לפי מותג הרכב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy konkrét alvázszámot és hibakódot — a diagnózis márkánként történik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et specifikt VIN og en fejlkode — diagnosen løses pr. bilmærke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna tietty VIN ja vikakoodi — diagnoosi ratkaistaan ajoneuvomerkin mukaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et spesifikt VIN og en feilkode — diagnosen løses per bilmerke."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte konkrétne VIN a chybový kód — diagnostika sa rieši podľa značky vozidla."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite konkretan VIN i kod kvara — dijagnostika se rješava po marki vozila."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете конкретен VIN и код на грешка — диагностиката е по марка на автомобила."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka VIN na msimbo wa hitilafu mahususi — utambuzi unatatuliwa kwa chapa ya gari."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix un VIN i un codi d’avaria concrets — el diagnòstic es resol per marca."
          }
        }
      }
    },
