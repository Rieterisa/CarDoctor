          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk memutar. Tanda oranye menunjukkan komponen yang kemungkinan bermasalah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للتدوير. العلامة البرتقالية تُظهر المكوّن المحتمل تعطله."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для вращения. Оранжевая метка показывает вероятную неисправную деталь."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Drehen ziehen. Orange Markierung zeigt das vermutlich defekte Bauteil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour faire pivoter. Le repère orange indique le composant probablement défectueux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで回転。オレンジの印が故障の可能性がある部品を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 회전하세요. 주황 표시가 고장 가능성이 있는 부품을 나타냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以旋转。橙色标记显示可能的故障部件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳以旋轉。橘色標記顯示可能故障的零件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để xoay. Dấu cam cho thấy linh kiện có thể bị lỗi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อหมุน เครื่องหมายสีส้มแสดงชิ้นส่วนที่น่าจะชำรุด"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per ruotare. Il segno arancione indica il componente probabilmente difettoso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby obrócić. Pomarańczowe oznaczenie wskazuje prawdopodobnie uszkodzony element."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te draaien. Oranje markering toont het waarschijnlijk defecte onderdeel."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk putar. Tanda jingga menunjukkan komponen yang mungkin rosak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-drag para i-rotate. Ipinapakita ng orange mark ang posibleng sira na bahagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھمانے کے لیے کھینچیں۔ نارنجی نشان ممکنہ خراب جزو دکھاتا ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘোরাতে টেনে আনুন। কমলা চিহ্ন সম্ভাব্য ত্রুটিপূর্ণ উপাদান দেখায়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای چرخاندن بکشید. علامت نارنجی قطعه احتمالاً معیوب را نشان می‌دهد."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб обернути. Помаранчева позначка показує ймовірно несправний вузол."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru a roti. Marcajul portocaliu arată componenta probabil defectă."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením otočíte. Oranžová značka ukazuje pravděpodobně vadný díl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att rotera. Orange markering visar den troligt felaktiga komponenten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για περιστροφή. Το πορτοκαλί σημάδι δείχνει το πιθανό ελαττωματικό εξάρτημα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו לסיבוב. הסימון הכתום מציג את הרכיב שככל הנראה פגום."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza a forgatáshoz. A narancssárga jel a valószínűleg hibás alkatrészt mutatja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at dreje. Orange markering viser den sandsynligt defekte komponent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kiertääksesi. Oranssi merkintä näyttää todennäköisesti viallisen osan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å rotere. Oransje merke viser den trolig defekte komponenten."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím otočíte. Oranžová značka ukazuje pravdepodobne chybný diel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za rotaciju. Narančasta oznaka pokazuje vjerojatno neispravan dio."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете за завъртане. Оранжевият маркер показва вероятния повреден компонент."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Buruta ili kuzungusha. Alama ya chungwa inaonyesha sehemu inayoweza kuwa na hitilafu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega per girar. La marca taronja mostra el component probablement defectuós."
          }
        }
      }
    },
